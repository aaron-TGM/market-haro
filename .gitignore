# secrets
.env
*.key

# data + generated output
# The SQLite database is a DERIVED artifact, rebuilt by `radar restore` from
# data/history/*.ndjson. Never commit it: git stores a full copy of a binary it
# cannot delta, and a year of daily commits would be gigabytes. See radar/archive.py.
data/*
!data/history/
!data/rankings/
!data/cards.ndjson
!data/sets.ndjson
!data/index.ndjson
!data/index_members.json
!data/notes/
!data/commentary/
!data/market_heat.json
!data/validation_history.json
out/
*.db
*.sqlite3
*.sqlite3-journal

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
.mypy_cache/

# os
.DS_Store
Thumbs.db

# node (screenshot tooling only, not part of the project)
node_modules/
package.json
package-lock.json
