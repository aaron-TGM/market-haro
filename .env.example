# Copy to .env and fill in. .env is gitignored -- never commit a real key.
TCGAPI_KEY=your_tcgapi_dev_key_here

# Only needed to run `radar publish` from this machine; the same value is the
# Worker's ADMIN_SECRET and the GitHub secret HARO_ADMIN_SECRET.
# HARO_ADMIN_SECRET=

# Optional overrides
# TCGAPI_BASE_URL=https://api.tcgapi.dev/v1
# RADAR_DB=data/radar.sqlite3
